#!/usr/bin/expect -f
# Usage: expect ssh_uni.exp "<remote command>"
# Forces password auth (the key path hangs on this host) and handles prompts.
set timeout 180
set cmd [lindex $argv 0]
set host "prateek@trux-hayabusa.uni.lux"
set pw "wsDP0RJPLhd2IwY"
set keypass "pkrajput"
log_user 1
spawn ssh -o StrictHostKeyChecking=accept-new -o ConnectTimeout=30 \
  -o PubkeyAuthentication=no -o PreferredAuthentications=password \
  $host $cmd
expect {
  -re "(?i)enter passphrase" { send "$keypass\r"; exp_continue }
  -re "(?i)password:" { send "$pw\r"; exp_continue }
  timeout { puts "\n>>> EXPECT_TIMEOUT" }
  eof
}
