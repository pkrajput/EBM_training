#!/usr/bin/expect -f
set timeout 40
set host "prateek@trux-hayabusa.uni.lux"
spawn ssh -v -o StrictHostKeyChecking=accept-new -o ConnectTimeout=20 -o PubkeyAuthentication=no -o PreferredAuthentications=password $host "echo REMOTE_OK"
expect {
  -re "(?i)password:" { send "wsDP0RJPLhd2IwY\r"; exp_continue }
  "REMOTE_OK" { puts "\n>>> SUCCESS" }
  timeout { puts "\n>>> TIMEOUT" }
  eof
}
